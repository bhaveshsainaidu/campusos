# CampusOS Frontend Environment Configuration

# Backend API base URL (e.g., https://campusos-backend.onrender.com or https://api.yourdomain.com)
# Leave unset or empty for local development to use the Vite local proxy (/api/v1 -> http://localhost:8080)
VITE_API_URL=

# WebSocket STOMP endpoint URL (optional, defaults to ${VITE_API_URL}/ws/campusos)
VITE_WS_URL=
