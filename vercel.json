{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm --prefix campusos-frontend install",
  "buildCommand": "npm --prefix campusos-frontend run build",
  "outputDirectory": "campusos-frontend/dist",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
